{
  "name": "nxphotobooth-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:classic": "node scripts/dev-classic.mjs",
    "start": "node --enable-source-maps dist/server.js",
    "worker": "tsx src/worker.ts",
    "test": "tsx --test test/api.test.ts test/models.test.ts test/engines.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test test/integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "worker:start": "node --enable-source-maps dist/worker.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "minio": "^8.0.5",
    "multer": "^2.0.2",
    "pg": "^8.16.0",
    "sharp": "^0.34.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
