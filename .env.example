NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://photobooth:photobooth@localhost:5432/photobooth?schema=public
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
KIOSK_API_KEY=replace-with-random-kiosk-key-at-least-32-characters
ADMIN_API_KEY=replace-with-random-admin-key-at-least-32-characters
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=photobooth
MINIO_REGION=us-east-1
# Public host must be reachable from browsers. Never rewrite a signed URL's host.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
PHOTO_SESSION_TTL_SECONDS=86400
PRESIGNED_URL_TTL_SECONDS=300
GENERATION_LIMIT=3
# Python BASIC endpoint, also used by CLASSIC. Run python-worker/basic_api.py.
AI_ENGINE_URL=
AI_ENGINE_API_KEY=
AI_ENGINE_TIMEOUT_MS=90000
BASIC_TEMPLATE_ID=sci-fi-space-commander-001
ADVANCED_EXPERIENCE_ID=mini-me
# ADVANCED runs directly in the Node worker, not through Python.
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=
# Optional comma-separated trusted CDN origins for URL responses. Redirects are rejected.
NINEROUTER_RESULT_ORIGINS=
UPLOAD_MAX_MB=10
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3
