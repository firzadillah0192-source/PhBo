# ---------------------------------------------------------------------------
# Photobooth AI — environment template.
# COPY to .env and fill in real values. NEVER commit .env (see .gitignore).
# All values below are safe placeholders.
# ---------------------------------------------------------------------------

# App
APP_NAME="Photobooth AI"
ENVIRONMENT=development

# --- Admin (keep private; admin API is disabled when empty) -----------
# Legacy setting retained for older rollback images; account-based admin ignores it.
ADMIN_TOKEN=
SESSION_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false

# --- Database (PostgreSQL) -------------------------------------------------
# Inside Docker Compose the host is the service name `photobooth-postgres`.
DATABASE_URL=postgresql+psycopg://photobooth:CHANGE_ME_DB_PASSWORD@photobooth-postgres:5432/photobooth

# Standalone Postgres credentials used by docker-compose.yml
POSTGRES_USER=photobooth
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=photobooth

# --- Queue / job state (Redis) ---------------------------------------------
REDIS_URL=redis://photobooth-redis:6379/0
QUEUE_NAME=photobooth:generation-queue

# --- Filesystem -------------------------------------------------------------
# On the VPS point these at /srv/photobooth/* (see docs/DEPLOYMENT.md).
# For local dev you can point RUNTIME_DIR at the repo-local ./runtime folder.
RUNTIME_DIR=/srv/photobooth
TEMPLATES_DIR=/srv/photobooth/templates

UPLOAD_MAX_BYTES=12582912
UPLOAD_MIN_DIMENSION=256
UPLOAD_MAX_DIMENSION=8000
# Upload bytes are temporary and cleaned after this retention period.
UPLOAD_RETENTION_HOURS=24
UPLOAD_CLEANUP_INTERVAL_SECONDS=3600

# --- AI provider ------------------------------------------------------------
# Selects the provider adapter. Supported: none | 9router
#   none    -> every generation fails with AI_PROVIDER_NOT_CONNECTED (honest)
#   9router -> uses the OpenAI-compatible gateway below
AI_PROVIDER=none

# --- Basic identity backend -------------------------------------------------
# V1 is the unchanged deterministic fallback/default. v2_experimental is
# intentionally unavailable until a separately licensed provider is installed.
BASIC_IDENTITY_BACKEND=v1

# 9router (OpenAI-compatible gateway), colocated on this VPS. Connect directly
# through the host gateway so long image requests avoid the public CDN timeout.
# For a remote gateway, configure its direct HTTPS origin instead.
NINEROUTER_BASE_URL=http://host.docker.internal:20128/v1
NINEROUTER_API_KEY=CHANGE_ME_9ROUTER_KEY
NINEROUTER_MODEL=cx/gpt-image-2.5
NINEROUTER_TIMEOUT_SECONDS=300

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# --- Google Identity Services / OpenID Connect ------------------------------
# Configure the OAuth web client ID from Google Cloud Console. The backend
# verifies the ID token and creates its own HttpOnly Photobooth session.
GOOGLE_CLIENT_ID=
# The same public client ID is embedded in the browser bundle for Google Identity Services.
VITE_GOOGLE_CLIENT_ID=

# --- Result delivery / kiosk ------------------------------------------------
# Opaque QR result links default to 24 hours; keep this separate from storage retention.
RESULT_CLAIM_TTL_HOURS=24
# Set the canonical HTTPS public origin in production; production rejects fallback hosts.
# Production origin: https://nxbooth.gennexbyte.com
# Development may leave this blank to use the forwarded request origin.
RESULT_CLAIM_PUBLIC_BASE_URL=
# Kiosk returns to its clean start screen after this many inactive seconds.
KIOSK_RESET_SECONDS=90

# --- PostHog (optional in production) ---------------------------------------
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
# Public ingestion token only; never place a personal API key in VITE variables.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=
