NODE_ENV=development
PORT=8081
# Dedicated candidate database only; do not use the active NXBooth database.
DATABASE_URL=postgresql://candidate:replace-me@127.0.0.1:55432/nxbooth_express_dev?schema=public
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
KIOSK_API_KEY=replace-with-random-kiosk-key-at-least-32-characters
ADMIN_API_KEY=replace-with-random-admin-key-at-least-32-characters
MINIO_ENDPOINT=localhost
MINIO_PORT=59000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-candidate-access-key
MINIO_SECRET_KEY=replace-with-candidate-secret-key
MINIO_BUCKET=nxbooth-express-dev
MINIO_REGION=us-east-1
# Public host must be reachable from browsers. Never rewrite a signed URL's host.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=59000
MINIO_PUBLIC_USE_SSL=false
PHOTO_SESSION_TTL_SECONDS=86400
PRESIGNED_URL_TTL_SECONDS=300
GENERATION_LIMIT=3
# Private Python helper for photo normalization, print formatting, and Classic composition only.
AI_ENGINE_URL=
AI_ENGINE_API_KEY=
AI_ENGINE_TIMEOUT_MS=90000
BASIC_TEMPLATE_ID=sci-fi-space-commander-framed-001
ADVANCED_EXPERIENCE_ID=mini-me
# Basic uses this server-side catalog model; Basic and Advanced both call NineRouter from Express.
BASIC_MODEL_EXPERIENCE_ID=mini-me
# Keep blank until the provider is intentionally configured.
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=
# Optional comma-separated trusted CDN origins for URL responses. Redirects are rejected.
NINEROUTER_RESULT_ORIGINS=
UPLOAD_MAX_MB=10
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=120
WORKER_MAX_ATTEMPTS=3

# Native /api runtime. MinIO stores customer uploads/results and catalog assets.
# Legacy path aliases read catalog objects first, then unmigrated local files.
# Reuse MINIO_* above. Pre-create a private bucket and a scoped application key.
# Private downloads stay behind the API unless direct signed delivery is enabled.
STORAGE_BACKEND=filesystem
# Optional direct private-image delivery. Uses MINIO_PUBLIC_* above without
# rewriting the signed host. Production requires a reachable HTTPS hostname.
MINIO_SIGNED_URLS_ENABLED=false
MINIO_PRESIGNED_URL_TTL_SECONDS=300
HOST=127.0.0.1
RUNTIME_DIR=/srv/photobooth
TEMPLATES_DIR=/srv/photobooth/templates
SESSION_SECRET_KEY=replace-with-candidate-only-session-secret
SESSION_DAYS=30
COOKIE_SECURE=false
RESULT_CLAIM_TTL_HOURS=24
RESULT_CLAIM_PUBLIC_BASE_URL=http://localhost:5173
KIOSK_RESET_SECONDS=90
# Native Kiosk adapter and PostgreSQL dispatch. Apply migrations 016–019 first.
# Disabled by default; the current /kiosk web flow and its cookies are preserved.
# KIOSK_API_KEY is defined above; supply it only to trusted Kiosk software.
NATIVE_KIOSK_ENABLED=false
KIOSK_PHOTO_SESSION_TTL_SECONDS=86400
KIOSK_GENERATION_LIMIT=3
IMAGE_ENGINE_NORMALIZE_URL=
UPLOAD_MAX_BYTES=12582912
UPLOAD_RETENTION_HOURS=24
# Dedicated candidate Redis only. Never enqueue candidate jobs on the live queue.
REDIS_URL=redis://127.0.0.1:6379/15
# Postgres dispatch requires migration 018. Redis remains the rate-limit store.
GENERATION_QUEUE_BACKEND=redis
QUEUE_NAME=nxbooth:express:candidate:generation
# Native worker starts only with an explicit worker:migration command.
PREVIEW_QUEUE_NAME=nxbooth:express:candidate:preview
IMAGE_ENGINE_BASE_URL=
AI_PROVIDER=none
NINEROUTER_TIMEOUT_SECONDS=300
PROVIDER_RESULT_ORIGINS=
GOOGLE_CLIENT_ID=
ADMIN_TOKEN=
ADMIN_DEFAULT_ROLE=superadmin
TRUST_PROXY=false
UPLOAD_MIN_DIMENSION=256
UPLOAD_MAX_DIMENSION=8000
UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
