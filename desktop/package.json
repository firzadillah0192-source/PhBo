{
  "name": "nxbooth-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/electron-ui.mjs",
    "bridge:build": "dotnet build native/KioskBridge -c Release",
    "package:win": "node scripts/package-windows.mjs",
    "test:webcam-ui": "node tests/webcam-ui.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "1.14.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "vite": "8.3.3",
    "playwright": "1.64.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.gennexbyte.nxbooth.desktop",
    "productName": "NXBooth Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/publish/win-x64",
        "to": "bridge"
      }
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "extraFiles": [
      {
        "from": "scripts/Start-NXBooth.ps1",
        "to": "Start-NXBooth.ps1"
      },
      {
        "from": "WINDOWS_SETUP.md",
        "to": "WINDOWS_SETUP.md"
      }
    ]
  },
  "description": "NXBooth Windows kiosk with webcam capture and Epson L8050 printing",
  "author": "Photobooth AI"
}
