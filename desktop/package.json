{
  "name": "nxbooth-desktop",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/electron-ui.mjs",
    "bridge:build": "dotnet build native/KioskBridge -c Release",
    "package:win": "node scripts/package-windows.mjs",
    "test:webcam-ui": "node tests/webcam-ui.mjs",
    "test:setup-ui": "node tests/setup-ui.mjs",
    "test:event-ui": "node tests/event-ui.mjs",
    "test:canon-ui": "node tests/canon-ui.mjs",
    "test:activity-ui": "node tests/activity-ui.mjs"
  },
  "dependencies": {
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "1.14.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0",
    "vite": "8.3.3"
  },
  "build": {
    "appId": "com.gennexbyte.nxbooth.desktop",
    "productName": "NXBooth Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/publish/win-x64",
        "to": "bridge"
      },
      {
        "from": "native/publish/update-signer.json",
        "to": "update-signer.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "extraFiles": [
      {
        "from": "WINDOWS_SETUP.md",
        "to": "WINDOWS_SETUP.md"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "NXBooth-Setup-${version}.exe"
    }
  },
  "description": "NXBooth Windows kiosk with Canon USB SDK capture and Windows printing",
  "author": "Photobooth AI"
}
