# Environment variables for the trusted desktop process, never VITE_* variables.
# No production credential is included here.
PHBO_DEVICE_MODE=hardware
# Optional exact Windows printer name when more than one L8050 is installed.
PHBO_PRINTER_NAME=
PHBO_OPERATOR_PIN=
PHBO_KIOSK_API_KEY=
# Optional path to a portable .NET SDK during source development.
PHBO_DOTNET=dotnet
