+import { describe, it, expect, vi, afterEach } from "vitest";
+const fetchReference = vi.hoisted(() => vi.fn());
+vi.mock("../../open-sse/translator/concerns/image.js", async importOriginal => ({ ...(await importOriginal()), fetchImageAsBase64: fetchReference }));
+import { handleImageGenerationCore } from "../../open-sse/handlers/imageGenerationCore.js";
+import createAdapter from "../../open-sse/handlers/imageProviders/openai.js";
+const a = createAdapter("openai"), image = "data:image/png;base64,iVBORw0KGgo=";
+afterEach(() => { fetchReference.mockReset(); vi.restoreAllMocks(); });
+describe("OpenAI reference editing", () => {
+  it("routes reference images to edits, preserves both files and Low", async () => {
+    const body = { prompt: "same prompt", images: [image, image], quality: "low", size: "1024x1536", response_format: "b64_json" };
+    expect(a.buildUrl("gpt-image-2.5-flare", {}, body)).toBe("https://api.openai.com/v1/images/edits");
+    const form = await a.buildBody("gpt-image-2.5-flare", body);
+    expect(form).toBeInstanceOf(FormData); expect(form.get("quality")).toBe("low");
+    expect(form.get("prompt")).toBe("same prompt"); expect(form.get("response_format")).toBeNull();
+    expect(form.getAll("image[]")).toHaveLength(2);
+    expect(a.buildHeaders({ apiKey: "synthetic" }, form)).toEqual({ Authorization: "Bearer synthetic" });
+    expect(Buffer.from(await form.getAll("image[]")[0].arrayBuffer()).toString("base64")).toBe("iVBORw0KGgo=");
+  });
+  it("orchestrator forwards multipart reference edits", async () => {
+    const upstream = vi.spyOn(globalThis, "fetch").mockResolvedValue(new Response(JSON.stringify({ created: 1, data: [{ b64_json: "iVBORw0KGgo=" }] }), { status: 200, headers: { "Content-Type": "application/json" } }));
+    const result = await handleImageGenerationCore({ body: { prompt: "x", images: [image, image], quality: "low", size: "1024x1536" }, modelInfo: { provider: "openai", model: "gpt-image-2.5-flare" }, credentials: { apiKey: "synthetic" } });
+    expect(result.success).toBe(true); expect(upstream).toHaveBeenCalledTimes(1);
+    const [url, init] = upstream.mock.calls[0];
+    expect(url).toBe("https://api.openai.com/v1/images/edits");
+    expect(init.body).toBeInstanceOf(FormData); expect(init.body.getAll("image[]")).toHaveLength(2);
+    expect(init.headers["Content-Type"]).toBeUndefined();
+  });
+  it("accepts image URL through the existing protected fetch helper", async () => {
+    fetchReference.mockResolvedValue({ url: image });
+    const form = await a.buildBody("gpt-image-2.5-sunburst", { prompt: "x", image: "https://example.com/reference.png", quality: "low" });
+    expect(fetchReference).toHaveBeenCalledWith("https://example.com/reference.png"); expect(form.getAll("image[]")).toHaveLength(1);
+  });
+  it("fails if a reference cannot be retrieved rather than silently generating without it", async () => {
+    fetchReference.mockResolvedValue(null);
+    await expect(a.buildBody("gpt-image-2.5-flare", { image: "https://example.com/missing.png" })).rejects.toThrow("reference");
+    await expect(a.buildBody("gpt-image-2.5-flare", { images: ["data:image/png;base64,!!"] })).rejects.toThrow("encoding");
+  });
+  it("keeps text-only generation on its original endpoint and JSON transport", () => {
+    const body = { prompt: "x", quality: "low" };
+    expect(a.buildUrl("gpt-image-2.5-flare", {}, body)).toBe("https://api.openai.com/v1/images/generations");
+    expect(a.buildBody("gpt-image-2.5-flare", body)).toEqual({ model: "gpt-image-2.5-flare", prompt: "x", n: 1, size: "1024x1024", quality: "low" });
+  });
+  it("keeps other providers unchanged", () => {
+    const adapter = createAdapter("openrouter");
+    expect(adapter.buildBody("model", { prompt: "x", images: [image] })).not.toBeInstanceOf(FormData);
+  });
+});
