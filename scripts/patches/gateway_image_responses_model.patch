index 0000000..27a6bf4
--- /dev/null
+++ b/tests/unit/codex-image-main-model.test.js
@@ -0,0 +1,25 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+afterEach(() => { vi.unstubAllEnvs(); vi.resetModules(); });
+
+describe("Codex Images API Responses model", () => {
+  it("uses an account-supported Responses model while preserving each requested image tool", async () => {
+    vi.stubEnv("CODEX_IMAGES_MAIN_MODEL", "");
+    const { default: provider } = await import("../../open-sse/handlers/imageProviders/codex.js");
+    for (const model of ["gpt-image-1.5", "gpt-image-2", "gpt-image-2.5", "gpt-image-2.5-flare", "gpt-image-2.5-sunburst"]) {
+      const result = provider.buildBody(model, { prompt: "synthetic test", images: ["data:image/png;base64,c3ludGhldGlj"] });
+      expect(result.model).toBe("gpt-5.6-sol");
+      expect(result.tools[0]).toMatchObject({ type: "image_generation", model, action: "edit" });
+      expect(result.input[0].content).toContainEqual({ type: "input_image", image_url: "data:image/png;base64,c3ludGhldGlj", detail: "high" });
+    }
+    expect(provider.buildBody("gpt-5.6-terra-image", { prompt: "synthetic" }).model).toBe("gpt-5.6-terra");
+  });
+
+  it("honors an explicit Responses-model configuration without altering the image model", async () => {
+    vi.stubEnv("CODEX_IMAGES_MAIN_MODEL", " gpt-6-astra ");
+    const { default: provider } = await import("../../open-sse/handlers/imageProviders/codex.js");
+    const body = provider.buildBody("gpt-image-2.5", { prompt: "synthetic" });
+    expect(body.model).toBe("gpt-6-astra");
+    expect(body.tools[0]).toMatchObject({ model: "gpt-image-2.5", action: "generate" });
+  });
+});
